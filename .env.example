# KMITL OpenAI-compatible API configuration.
# Copy this file to .env.local and put the real token there. Never commit the real token.
AI_API_KEY=
AI_BASE_URL=https://api.ai.kmitl.ac.th/v1

# KMITL requires openrouter/ as the model-name prefix.
# The app adds this automatically when an explicitly configured model does not already have it.
AI_MODEL_PREFIX=openrouter/

# Optional shared chat model id. Leave blank to let the app query /models and try, in order:
# Deepseek v4 Flash -> Kimi K3 -> Grok 4.6.
# You can also set the exact model id returned by GET /models.
AI_CHAT_MODEL=

# Optional purpose-specific overrides. When blank, AI_CHAT_MODEL / auto-discovery is used.
AI_FEEDBACK_MODEL=
AI_CONVERSATION_MODEL=

# Optional cloud speech-to-text model.
# Set this only if KMITL exposes a model compatible with POST /audio/transcriptions.
# Browser Speech Recognition + manual transcript correction remain the safe fallback.
AI_TRANSCRIPTION_MODEL=
