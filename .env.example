# Optional. The core Speaking Coach still works with browser speech recognition/manual transcript correction.
# Keep this server-side only. Never expose it through NEXT_PUBLIC_*.
OPENAI_API_KEY=

# High-accuracy speech-to-text. Current default if omitted: gpt-4o-mini-transcribe
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Optional transcript-language feedback. Current default if omitted: gpt-5.6-luna
OPENAI_FEEDBACK_MODEL=gpt-5.6-luna

# Optional adaptive conversation follow-up model. Falls back to OPENAI_FEEDBACK_MODEL, then gpt-5.6-luna.
OPENAI_CONVERSATION_MODEL=gpt-5.6-luna
